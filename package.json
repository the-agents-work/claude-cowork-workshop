{
  "name": "claude-cowork-workshop",
  "version": "1.0.0",
  "private": true,
  "description": "Workshop slides: Claude Cowork & ung dung thuc te (event 22/5/2026, 163 attendees)",
  "scripts": {
    "build": "npm run build:pdf && npm run build:html",
    "build:pdf": "marp slides.md --pdf --allow-local-files -o docs/claude-cowork-workshop.pdf",
    "build:html": "marp slides.md --html --allow-local-files -o docs/index.html",
    "build:pptx": "marp slides.md --pptx --allow-local-files -o docs/claude-cowork-workshop.pptx",
    "watch": "marp slides.md --watch --html --allow-local-files -o docs/index.html",
    "serve": "marp slides.md --server"
  },
  "devDependencies": {
    "@marp-team/marp-cli": "^4.4.0"
  },
  "license": "MIT",
  "author": "nguyen ba nghia <namkent1612000@gmail.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/the-agents-work/claude-cowork-workshop"
  }
}
